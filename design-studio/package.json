{
  "name": "lai-studio",
  "version": "1.0.0",
  "description": "Lai Studio - web design editor",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "build:offline": "vite build --mode offline",
    "preview": "vite preview",
    "test": "node tests/e2e.cjs && node tests/office.cjs",
    "test:office": "node tests/office.cjs",
    "test:docs": "node tests/docs.cjs",
    "illus:prompts": "python3 illustrations/build_prompts.py",
    "illus:check": "python3 tools/check_illustrations.py",
    "illus:import": "python3 tools/import_illustrations.py",
    "test:illus": "python3 tests/illustrations_test.py"
  },
  "dependencies": {
    "docx": "^9.16.0",
    "fabric": "^6.9.1",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "mathjax-full": "^3.2.2",
    "pptxgenjs": "^4.0.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "opentype.js": "^2.0.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "private": true,
  "type": "module"
}
